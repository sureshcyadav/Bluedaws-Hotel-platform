# ── Server ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL (Render provides this as one URL) ─────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/bluedaws_hotel

# In production the DB connection verifies the server's TLS certificate.
# Leave both unset first — most managed Postgres (incl. Render) presents a
# publicly-trusted cert and this just works. If connections start failing
# after deploy with a certificate error, either:
#   1) paste the provider's CA certificate (PEM) here, or
#   2) set DATABASE_SSL_INSECURE=true as a temporary rollback (no redeploy
#      needed — it's read from env at connect time) while you sort out (1).
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...
# DATABASE_SSL_INSECURE=true

# ── CORS (comma-separated list of allowed frontend origins) ──────────────
ALLOWED_ORIGINS=https://sureshcyadav.github.io,http://localhost:5500

# ── Admin portal password ──────────────────────────────────────────────
# Preferred: store a bcrypt HASH of the password, not the password itself.
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-real-password', 12))"
# then set the output below and DELETE the legacy ADMIN_PASSWORD var entirely.
ADMIN_PASSWORD_HASH=change_me_to_a_bcrypt_hash

# Legacy fallback (plaintext) — only used if ADMIN_PASSWORD_HASH is not set.
# Kept temporarily for zero-downtime migration; remove once ADMIN_PASSWORD_HASH is live.
ADMIN_PASSWORD=change_me_to_something_long_and_random

# ── JWT signing secret (SEPARATE from ADMIN_PASSWORD — 32+ random chars) ─
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_characters

# ── Gmail SMTP (for booking confirmation and enquiry emails) ──────────────
# GMAIL_USER    : the Gmail address emails are sent from
# GMAIL_APP_PASSWORD : a Gmail App Password (NOT your account password)
#   To generate: myaccount.google.com → Security → 2-Step Verification → App passwords
#   Enter the 16-char code with NO spaces (e.g. tepmdbxogmolrgrw)
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
